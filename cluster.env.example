# Copy to cluster.env and edit for your environment.
#   cp cluster.env.example cluster.env
# cluster.env is gitignored so your real addresses stay local.

# Path to a kubespray checkout (see docs/runbook.md step 1).
KUBESPRAY_DIR="${HOME}/kubespray"

# Ansible inventory to use, relative to KUBESPRAY_DIR.
INVENTORY="inventory/mycluster/inventory.ini"

# SSH user on the target nodes.
SSH_USER="root"

# Private key used to reach the nodes.
SSH_KEY="${HOME}/.ssh/id_ed25519"

# Every node in the cluster, space separated.
NODES="192.168.56.134 192.168.56.135"

# The control-plane node kubeconfig is pulled from.
CONTROL_PLANE="192.168.56.134"
